          "x": 900,
          "y": 600
        },
        "actions": [
          {
            "do": "focus",
            "app": "terminal",
            "cue": "終端機"
          },
          {
            "do": "type",
            "app": "terminal",
            "typed": "ping example.com",
            "cue": "打指令",
            "speed": 1.3
          },
          {
            "do": "enter",
            "app": "terminal",
            "after": 0.2,
            "output": [
              "",
              "Ping example.com [93.184.215.14] (使用 32 位元組的資料):",
              "回覆自 93.184.215.14: 位元組=32 時間=12ms TTL=56",
              "回覆自 93.184.215.14: 位元組=32 時間=11ms TTL=56",
              ""
            ]
          },
          {
            "do": "zoom",
            "to": "term:時間=12ms",
            "z": 1.8,
            "cue": "結果"
          },
          {
            "do": "highlight",
            "to": "term:時間=12ms",
            "after": 0.2
          },
          {
            "do": "callout",
            "to": "term:時間=12ms",
            "side": "below",
            "text": "輸出[[一行一行]]印出來",
            "cue": "一行一行"
          }
        ]
      },
      "lines": [
        "打開終端機打指令，",
        "結果會一行一行印出來，重點再用螢光筆標起來。"
      ]
