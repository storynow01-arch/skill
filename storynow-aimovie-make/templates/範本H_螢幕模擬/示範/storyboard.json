              "from": "other",
              "text": "嗨！需要什麼幫忙？"
            }
          ]
        },
        "actions": [
          {
            "do": "tap",
            "to": "mic",
            "cue": "手機"
          },
          {
            "do": "message",
            "from": "me",
            "text": "幫我做一支影片",
            "cue": "對話"
          },
          {
            "do": "message",
            "from": "other",
            "text": "好的，分鏡馬上給你看 ✓",
            "cue": "演得出來"
          },
          {
            "do": "zoom",
            "to": "phone:last",
            "z": 1.4,
            "after": 0.1
          }
        ]
      },
      "lines": [
        "手機上的 App 對話，也演得出來，訊息會一則一則跳出來。"
      ]
    },
    {
      "id": "S5",
      "type": "recap",
      "props": {
        "heading": "範本 H 重點",
        "points": [
          "不用錄螢幕",
          "操作跟著旁白",
          "放大加泡泡"
